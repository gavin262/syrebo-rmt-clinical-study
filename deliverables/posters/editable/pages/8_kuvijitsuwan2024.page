pageType: content
background:
  type: gradient
  gradientType: linear
  angle: 90
  stops:
    - {position: 0, color: "$pale"}
    - {position: 1, color: "$paleblue"}
elements:
  - elementId: top-rule
    elementType: shape
    bounds: [0, 0, 960, 12]
    shapeName: rect
    fill: {type: solid, color: "#8A5A44"}
  - elementId: brand
    elementType: text
    bounds: [60, 45, 350, 55]
    content: {fontSize: 34, fontFamily: MiSans, bold: true, color: "$navy", wrap: false, text: SYREBO}
  - elementId: series
    elementType: text
    bounds: [500, 48, 400, 58]
    content:
      fontSize: 14
      fontFamily: MiSans
      bold: true
      color: "$muted"
      align: [right, top]
      text: |
        <p>二次提及／测量工具研究</p><p>ORIGINAL RECORD · 2024</p>
  - elementId: title
    elementType: text
    bounds: [60, 135, 840, 150]
    content:
      fontSize: 43
      fontFamily: 得意黑
      color: "$navy"
      lineHeight: 1.25
      text: |
        <p>品牌出现在论文里</p><p>≠ 品牌设备被实验</p>
  - elementId: subtitle
    elementType: text
    bounds: [60, 310, 840, 65]
    content:
      fontSize: 22
      fontFamily: MiSans
      bold: true
      color: "#8A5A44"
      text: air-guitar测量学研究｜二次提及示例
  - elementId: stat-bg
    elementType: shape
    bounds: [45, 395, 870, 175]
    shapeName: roundRect
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: stat0
    elementType: text
    bounds: [60, 410, 250, 135]
    content:
      fontFamily: MiSans
      color: "$navy"
      text: |
        <p><span style="font-size:30px"><strong>10名</strong></span></p><p style="margin-top:8px"><span style="font-size:14px; color:$muted">健康右利手受试者</span></p>
  - elementId: stat1
    elementType: text
    bounds: [350, 410, 250, 135]
    content:
      fontFamily: MiSans
      color: "$navy"
      text: |
        <p><span style="font-size:30px"><strong>0.82–0.99</strong></span></p><p style="margin-top:8px"><span style="font-size:14px; color:$muted">air-guitar重测ICC</span></p>
  - elementId: stat2
    elementType: text
    bounds: [640, 410, 250, 135]
    content:
      fontFamily: MiSans
      color: "$navy"
      text: |
        <p><span style="font-size:30px"><strong>1°–9°</strong></span></p><p style="margin-top:8px"><span style="font-size:14px; color:$muted">MDC95范围</span></p>
  - elementId: result-bg
    elementType: shape
    bounds: [0, 620, 960, 350]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: result-label
    elementType: text
    bounds: [60, 655, 840, 40]
    content: {fontSize: 20, fontFamily: MiSans, bold: true, color: "#A9C8E8", text: "核心信息  /  KEY READING"}
  - elementId: result
    elementType: text
    bounds: [60, 720, 840, 130]
    content:
      fontSize: 41
      fontFamily: 得意黑
      color: "$white"
      lineHeight: 1.3
      text: |
        <p>自研 air-guitar</p><p>SYREBO 仅在引言出现</p>
  - elementId: result-note
    elementType: text
    bounds: [60, 865, 840, 80]
    content:
      fontSize: 16
      fontFamily: MiSans
      color: "$paleblue"
      lineHeight: 1.45
      text: 这篇论文不能与SYREBO直接工程研究混算。研究测试的是清迈大学自研air-guitar测量系统，SYREBO仅作为商用设备例子在引言出现。其价值在于手指静态屈曲测量的效度与重测信度，而不是SYREBO设备性能或疗效。
  - elementId: boundary-rule
    elementType: shape
    bounds: [60, 1010, 8, 112]
    shapeName: rect
    fill: {type: solid, color: "$orange"}
  - elementId: boundary
    elementType: text
    bounds: [88, 1000, 812, 135]
    content:
      fontSize: 19
      fontFamily: MiSans
      color: "$ink"
      lineHeight: 1.45
      text: |
        <p><strong>研究边界</strong></p><p>10名健康者；静态屈曲测量。不可计入SYREBO直接工程或临床证据。</p>
  - elementId: source
    elementType: text
    bounds: [60, 1160, 840, 75]
    content:
      fontSize: 12
      fontFamily: MiSans
      color: "$muted"
      lineHeight: 1.35
      text: |
        <p>Kuvijitsuwan et al. · Scientific Reports · 2024</p><p>DOI: 10.1038/s41598-024-71094-y</p>
