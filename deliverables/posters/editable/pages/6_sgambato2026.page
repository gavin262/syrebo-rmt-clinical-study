pageType: content
background:
  type: gradient
  gradientType: linear
  angle: 90
  stops:
    - {position: 0, color: "$pale"}
    - {position: 1, color: "$paleblue"}
elements:
  - elementId: top-rule
    elementType: shape
    bounds: [0, 0, 960, 12]
    shapeName: rect
    fill: {type: solid, color: "#147D7E"}
  - elementId: brand
    elementType: text
    bounds: [60, 45, 350, 55]
    content: {fontSize: 34, fontFamily: MiSans, bold: true, color: "$navy", wrap: false, text: SYREBO}
  - elementId: series
    elementType: text
    bounds: [500, 48, 400, 58]
    content:
      fontSize: 14
      fontFamily: MiSans
      bold: true
      color: "$muted"
      align: [right, top]
      text: |
        <p>直接人机接口工程研究</p><p>ORIGINAL RECORD · 2026</p>
  - elementId: title
    elementType: text
    bounds: [60, 135, 840, 150]
    content:
      fontSize: 43
      fontFamily: 得意黑
      color: "$navy"
      lineHeight: 1.25
      text: |
        <p>A模式超声 × 软体手部外骨骼</p><p>人机接口可行性探索</p>
  - elementId: subtitle
    elementType: text
    bounds: [60, 310, 840, 65]
    content:
      fontSize: 22
      fontFamily: MiSans
      bold: true
      color: "#147D7E"
      text: 主动／被动条件｜健康受试者工程研究
  - elementId: stat-bg
    elementType: shape
    bounds: [45, 395, 870, 175]
    shapeName: roundRect
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: stat0
    elementType: text
    bounds: [60, 410, 250, 135]
    content:
      fontFamily: MiSans
      color: "$navy"
      text: |
        <p><span style="font-size:30px"><strong>5名</strong></span></p><p style="margin-top:8px"><span style="font-size:14px; color:$muted">健康受试者</span></p>
  - elementId: stat1
    elementType: text
    bounds: [350, 410, 250, 135]
    content:
      fontFamily: MiSans
      color: "$navy"
      text: |
        <p><span style="font-size:30px"><strong>7种</strong></span></p><p style="margin-top:8px"><span style="font-size:14px; color:$muted">标准化协议来源抓握</span></p>
  - elementId: stat2
    elementType: text
    bounds: [640, 410, 250, 135]
    content:
      fontFamily: MiSans
      color: "$navy"
      text: |
        <p><span style="font-size:30px"><strong>A-mode</strong></span></p><p style="margin-top:8px"><span style="font-size:14px; color:$muted">超声人机接口</span></p>
  - elementId: result-bg
    elementType: shape
    bounds: [0, 620, 960, 350]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: result-label
    elementType: text
    bounds: [60, 655, 840, 40]
    content: {fontSize: 20, fontFamily: MiSans, bold: true, color: "#A9C8E8", text: "核心信息  /  KEY READING"}
  - elementId: result
    elementType: text
    bounds: [60, 720, 840, 130]
    content:
      fontSize: 41
      fontFamily: 得意黑
      color: "$white"
      lineHeight: 1.3
      text: |
        <p>5名健康受试者</p><p>7种抓握任务</p>
  - elementId: result-note
    elementType: text
    bounds: [60, 865, 840, 80]
    content:
      fontSize: 16
      fontFamily: MiSans
      color: "$paleblue"
      lineHeight: 1.45
      text: 这项研究探索A模式超声能否作为软体手部外骨骼的人机接口，在主动与被动条件下识别抓握意图。机构库摘要片段显示5名健康受试者完成7种源于标准化评估协议的抓握。它是工程可行性研究，不是卒中患者临床疗效研究。
  - elementId: boundary-rule
    elementType: shape
    bounds: [60, 1010, 8, 112]
    shapeName: rect
    fill: {type: solid, color: "$orange"}
  - elementId: boundary
    elementType: text
    bounds: [88, 1000, 812, 135]
    content:
      fontSize: 19
      fontFamily: MiSans
      color: "$ink"
      lineHeight: 1.45
      text: |
        <p><strong>研究边界</strong></p><p>不是患者疗效研究；完整准确率与设备品牌型号待全文。</p>
  - elementId: source
    elementType: text
    bounds: [60, 1160, 840, 75]
    content:
      fontSize: 12
      fontFamily: MiSans
      color: "$muted"
      lineHeight: 1.35
      text: |
        <p>Bruno Grandi Sgambato et al. · 2026 11th IEEE RAS/EMBS International Conference on Biomedical Robotics and Biomechatronics, 495–500 · 2026</p><p>DOI: 10.1109/BIOROB66782.2026.11681602</p>
