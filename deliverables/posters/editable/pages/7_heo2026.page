pageType: content
background:
  type: gradient
  gradientType: linear
  angle: 90
  stops:
    - {position: 0, color: "$pale"}
    - {position: 1, color: "$paleblue"}
elements:
  - elementId: top-rule
    elementType: shape
    bounds: [0, 0, 960, 12]
    shapeName: rect
    fill: {type: solid, color: "#147D7E"}
  - elementId: brand
    elementType: text
    bounds: [60, 45, 350, 55]
    content: {fontSize: 34, fontFamily: MiSans, bold: true, color: "$navy", wrap: false, text: SYREBO}
  - elementId: series
    elementType: text
    bounds: [500, 48, 400, 58]
    content:
      fontSize: 14
      fontFamily: MiSans
      bold: true
      color: "$muted"
      align: [right, top]
      text: |
        <p>气动源工程研究</p><p>ORIGINAL RECORD · 2026</p>
  - elementId: title
    elementType: text
    bounds: [60, 135, 840, 150]
    content:
      fontSize: 43
      fontFamily: 得意黑
      color: "$navy"
      lineHeight: 1.25
      text: |
        <p>无电子元件气动源</p><p>软体机器人的低热近静音路径</p>
  - elementId: subtitle
    elementType: text
    bounds: [60, 310, 840, 65]
    content:
      fontSize: 22
      fontFamily: MiSans
      bold: true
      color: "#147D7E"
      text: 化学反应＋被动机械调节
  - elementId: stat-bg
    elementType: shape
    bounds: [45, 395, 870, 175]
    shapeName: roundRect
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: stat0
    elementType: text
    bounds: [60, 410, 250, 135]
    content:
      fontFamily: MiSans
      color: "$navy"
      text: |
        <p><span style="font-size:30px"><strong>7 bar</strong></span></p><p style="margin-top:8px"><span style="font-size:14px; color:$muted">稳态输出压力</span></p>
  - elementId: stat1
    elementType: text
    bounds: [350, 410, 250, 135]
    content:
      fontFamily: MiSans
      color: "$navy"
      text: |
        <p><span style="font-size:30px"><strong>6 L/min</strong></span></p><p style="margin-top:8px"><span style="font-size:14px; color:$muted">稳态流量</span></p>
  - elementId: stat2
    elementType: text
    bounds: [640, 410, 250, 135]
    content:
      fontFamily: MiSans
      color: "$navy"
      text: |
        <p><span style="font-size:30px"><strong>36°C／40 dBA</strong></span></p><p style="margin-top:8px"><span style="font-size:14px; color:$muted">最高温度／噪声</span></p>
  - elementId: result-bg
    elementType: shape
    bounds: [0, 620, 960, 350]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: result-label
    elementType: text
    bounds: [60, 655, 840, 40]
    content: {fontSize: 20, fontFamily: MiSans, bold: true, color: "#A9C8E8", text: "核心信息  /  KEY READING"}
  - elementId: result
    elementType: text
    bounds: [60, 720, 840, 130]
    content:
      fontSize: 41
      fontFamily: 得意黑
      color: "$white"
      lineHeight: 1.3
      text: |
        <p>7 bar｜6 L/min</p><p>36°C｜40 dBA</p>
  - elementId: result-note
    elementType: text
    bounds: [60, 865, 840, 80]
    content:
      fontSize: 16
      fontFamily: MiSans
      color: "$paleblue"
      lineHeight: 1.45
      text: 研究提出一种集成吸热—放热化学反应的气动源，不依赖电子元件，并通过被动机械部件自动调节反应。摘要报告稳态输出7 bar、6 L/min，最高温度36°C、噪声40 dBA。它解决的是软体机器人供能问题，不是患者疗效问题。
  - elementId: boundary-rule
    elementType: shape
    bounds: [60, 1010, 8, 112]
    shapeName: rect
    fill: {type: solid, color: "$orange"}
  - elementId: boundary
    elementType: text
    bounds: [88, 1000, 812, 135]
    content:
      fontSize: 19
      fontFamily: MiSans
      color: "$ink"
      lineHeight: 1.45
      text: |
        <p><strong>研究边界</strong></p><p>台架工程性能，不是临床疗效；是否演示SYREBO设备待全文。</p>
  - elementId: source
    elementType: text
    bounds: [60, 1160, 840, 75]
    content:
      fontSize: 12
      fontFamily: MiSans
      color: "$muted"
      lineHeight: 1.35
      text: |
        <p>Ung Heo et al. · Soft Robotics, OnlineFirst · 2026</p><p>DOI: 10.1177/21695172261442062</p>
